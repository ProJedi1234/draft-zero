# Copy to .env.local and go — the defaults below work as-is against the
# Postgres in compose.yaml, so nothing here needs filling in for local dev.
# `bun run <script>` and `next dev` both load .env.local automatically.
#
#   docker compose up -d
#   cp .env.example .env.local
#   bun run db:migrate
#
# Port 5433, not 5432: a non-default port, so this stack coexists with any
# Postgres you already run on 5432 instead of fighting it for the port. To use
# one you already have, create a role and database there once and point
# DATABASE_URL at it:
#
#   psql -U postgres \
#     -c "CREATE ROLE draft_zero LOGIN PASSWORD '<password>';" \
#     -c "CREATE DATABASE draft_zero OWNER draft_zero;"
DATABASE_URL=postgresql://draft_zero:draft_zero@127.0.0.1:5433/draft_zero

# Optional. Overrides the OpenRouter key saved on the Settings page.
# When neither is set, generation falls back to the offline mock provider.
OPENROUTER_API_KEY=

# Optional. An IANA zone id and a BCP-47 tag, overriding the day boundary and
# date formatting the usage page otherwise reads off this machine.
DRAFT_ZERO_TIME_ZONE=
DRAFT_ZERO_LOCALE=

# Optional. Extra hostnames /api/mcp answers to, beside localhost. Needed when
# an MCP client reaches the server by a LAN name rather than 127.0.0.1 —
# without it the DNS-rebinding guard answers 403 "Invalid Host: <name>".
MCP_ALLOWED_HOSTS=

# Optional. Extra origins the dev server serves /_next/* resources to, beside
# 127.0.0.1, comma-separated. Needed to load the dev server from another device
# on your network — without it HMR silently stops reconnecting. Wildcards are
# allowed, e.g. 192.168.1.*,*.lan
DRAFT_ZERO_DEV_ORIGINS=
