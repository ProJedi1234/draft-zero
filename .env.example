# Copy to .env.local and fill in. `bun run <script>` and `next dev` both load
# .env.local automatically.
#
# Dev (this box): the shared `devpg` Docker container on 127.0.0.1:5432, with a
# database and owner role per app. Create them once:
#
#   docker exec devpg psql -U postgres \
#     -c "CREATE ROLE draft_zero LOGIN PASSWORD '<password>';" \
#     -c "CREATE DATABASE draft_zero OWNER draft_zero;"
#
# Prod (hestia): point at clio — postgresql://…@192.168.0.199:5432/draft_zero
DATABASE_URL=postgresql://draft_zero:<password>@127.0.0.1:5432/draft_zero
