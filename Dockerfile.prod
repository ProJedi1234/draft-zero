# Production image: `next build` at image build time, `next start` at run time.
# Same node-with-bun arrangement as Dockerfile.dev, for the same reason: bun is
# the package manager and script runner, but Next must run under real Node.
FROM node:22-alpine

COPY --from=oven/bun:1-alpine /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# force-dynamic everywhere, so the build prerenders nothing DB-backed and needs
# no database. A DATABASE_URL at runtime is still required.
RUN bun run build

EXPOSE 3000

CMD ["bun", "run", "next", "start", "--hostname", "0.0.0.0"]
