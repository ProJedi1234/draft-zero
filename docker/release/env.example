# Rename to .env beside compose.yaml. Only POSTGRES_PASSWORD is required.

# Letters and digits only: it is spliced into a postgresql:// URL unescaped.
POSTGRES_PASSWORD=

# Optional. Pins the image to a release; the attached compose.yaml already
# defaults to the release it came with.
DRAFT_ZERO_VERSION=

# Optional. Where the app listens, as host:port. The default, 127.0.0.1:3000,
# is this machine only. The app has no login, so publish it wider only on a
# network you trust or behind a proxy that authenticates.
DRAFT_ZERO_BIND=

# Optional. Overrides the OpenRouter key saved on the Settings page.
# When neither is set, generation falls back to the offline mock provider.
OPENROUTER_API_KEY=

# Optional. An Ollama host whose installed models appear in every model picker,
# and the context window sent with every local request (default 65536).
OLLAMA_BASE_URL=
OLLAMA_NUM_CTX=

# Optional. An IANA zone id and a BCP-47 tag for the usage page. The container
# runs in UTC otherwise.
DRAFT_ZERO_TIME_ZONE=
DRAFT_ZERO_LOCALE=

# Optional. Extra hostnames /api/mcp answers to, beside localhost.
MCP_ALLOWED_HOSTS=

# Optional. Store generated pictures in an S3 bucket instead of the app-data
# volume. All five or none.
DRAFT_ZERO_IMAGES_S3_ENDPOINT=
DRAFT_ZERO_IMAGES_S3_BUCKET=
DRAFT_ZERO_IMAGES_S3_REGION=
DRAFT_ZERO_IMAGES_S3_ACCESS_KEY_ID=
DRAFT_ZERO_IMAGES_S3_SECRET_ACCESS_KEY=
